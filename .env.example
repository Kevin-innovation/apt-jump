# Browser build: the public address of the Convex deployment. Leave empty for a game without online features.
VITE_CONVEX_URL=

# The following belong in the Convex deployment (npx convex env set NAME ...), never in a VITE_ variable or a file here:
#   AUTH_GOOGLE_CLIENT_ID
#   AUTH_GOOGLE_CLIENT_SECRET
#   SITE_ORIGINS   pages sign-in may return to, comma separated (default https://apt-jump-wine.vercel.app)
